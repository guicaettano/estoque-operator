{
  "name": "estoque-operator",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "matching:benchmark": "tsx --env-file=.env.local scripts/benchmark-product-matching.ts",
    "matching:benchmark-tagplus": "tsx --env-file=.env.local scripts/benchmark-tagplus-matching.ts",
    "matching:diagnose-osias": "tsx --env-file=.env.local scripts/diagnose-osias-matching.ts",
    "matching:retrieval-benchmark": "tsx --env-file=.env.local scripts/benchmark-retrieval-osias.ts",
    "matching:final-pipeline-benchmark": "tsx --env-file=.env.local scripts/benchmark-final-pipeline-osias.ts",
    "matching:find-product": "tsx --env-file=.env.local scripts/find-product.ts",
    "matching:label-osias": "tsx --env-file=.env.local scripts/label-osias.ts",
    "matching:index-embeddings": "tsx --env-file=.env.local scripts/index-product-embeddings.ts",
    "tagplus:sync-catalog": "tsx --env-file=.env.local scripts/sync-tagplus-catalog.ts",
    "cci:sync": "npm --prefix connectors/cci run sync",
    "cci:create-token": "tsx --env-file=.env.local scripts/create-cci-connector-token.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "fast-xml-parser": "^5.2.5",
    "next": "^16.0.0",
    "node-firebird": "^2.15.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
