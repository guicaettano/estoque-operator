NEXT_PUBLIC_SUPABASE_URL=
# Use a chave publishable nova ou mantenha a anon legada abaixo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL pública da aplicação, sem barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TAGPLUS_CLIENT_ID=
TAGPLUS_CLIENT_SECRET=
# Example: http://localhost:3000/api/integrations/tagplus/callback
TAGPLUS_REDIRECT_URI=
# UUID da loja TagPlus para a carga completa e somente leitura do catálogo.
TAGPLUS_CATALOG_STORE_ID=

# Optional fallback for scanned PDFs, matching reranking and semantic retrieval.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-5.4
OPENAI_MATCHING_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Server-side embedding backfill (never configure these in connectors/cci/.env).
MATCH_INDEX_STORE_ID=
MATCH_INDEX_PROVIDER=cci
MATCH_INDEX_BATCH_SIZE=50
# MATCH_INDEX_MAX_PRODUCTS=1000
