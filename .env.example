NEXT_PUBLIC_SUPABASE_URL=
# Use a chave publishable nova ou mantenha a anon legada abaixo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL pública da aplicação, sem barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TAGPLUS_CLIENT_ID=
TAGPLUS_CLIENT_SECRET=
# Example: http://localhost:3000/api/integrations/tagplus/callback
TAGPLUS_REDIRECT_URI=

# Optional fallback for scanned PDFs and unknown supplier layouts.
# PDFs are sent to the configured OpenAI model only after deterministic parsing fails.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-5.4
